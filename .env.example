# LexAI Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file -- it is listed in .gitignore

# -------------------------------------------------------
# REQUIRED
# -------------------------------------------------------

# Google Gemini API key -- obtain free at https://aistudio.google.com/apikey
# Using Gemini 1.5 Flash for 15 RPM free tier (vs Pro''s 2 RPM)
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# OPTIONAL -- defaults shown
# -------------------------------------------------------

GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
CHROMA_DIR=./chroma_db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
